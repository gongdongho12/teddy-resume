<script>
  /**
   * Automatic pagination for the A4 resume.
   *
   * Page dimensions are measured from CSS millimetres in the current media mode.
   * The original source container is retained as a template so pagination can be
   * rebuilt when the browser switches from screen styles to print styles.
   */
  const A4_HEIGHT_MM = 297;
  const PAGE_MARGIN_MM = 12;
  const SAFE_BUFFER_PX = 20;
  const MOBILE_BREAKPOINT_PX = 768;
  let resizeTimer: number | undefined;
  const paginationSources: Array<{
    id: string;
    anchor: Comment;
    template: HTMLElement;
  }> = [];

  function rememberPaginationSources() {
    document.querySelectorAll<HTMLElement>('.auto-paginate').forEach((container, index) => {
      const id = `a4-source-${index + 1}`;
      const anchor = document.createComment(id);
      container.dataset.a4Owner = id;
      container.before(anchor);
      paginationSources.push({ id, anchor, template: container.cloneNode(true) as HTMLElement });
    });
  }

  function restorePaginationSources() {
    paginationSources.forEach(({ id, anchor, template }) => {
      document.querySelectorAll<HTMLElement>(`[data-a4-owner="${id}"]`).forEach((element) => {
        element.remove();
      });
      anchor.after(template.cloneNode(true));
    });
  }

  function measureMillimetres(mm: number) {
    const probe = document.createElement('div');
    probe.style.cssText = [
      'position:absolute',
      'visibility:hidden',
      'pointer-events:none',
      'inset:auto',
      'width:1px',
      `height:${mm}mm`,
    ].join(';');
    document.body.appendChild(probe);
    const pixels = probe.getBoundingClientRect().height;
    probe.remove();
    return pixels;
  }

  function twoAnimationFrames() {
    return new Promise<void>((resolve) => {
      requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
    });
  }

  function numericMargin(value: string) {
    const parsed = Number.parseFloat(value);
    return Number.isFinite(parsed) ? parsed : 0;
  }

  function paginateNow() {
    document.documentElement.dataset.a4PaginationReady = 'false';

    const pageHeight = measureMillimetres(A4_HEIGHT_MM);
    const pageMargin = measureMillimetres(PAGE_MARGIN_MM);
    const containers = document.querySelectorAll<HTMLElement>('.auto-paginate:not([data-paginated="true"])');
    const oversizeItems: string[] = [];

    containers.forEach((container) => {
      const contentWrapper = container.querySelector<HTMLElement>('.paginate-content');
      if (!contentWrapper) return;

      const children = Array.from(contentWrapper.children).filter(
        (child) => !child.classList.contains('print-spacer'),
      ) as HTMLElement[];
      const pages: HTMLElement[][] = [];
      let currentPageItems: HTMLElement[] = [];
      const isCreative = container.dataset.template === 'creative';
      const topInset = pageMargin;
      const bottomInset = isCreative ? 0 : pageMargin;
      const usableHeight = pageHeight - topInset - bottomInset - SAFE_BUFFER_PX;
      const maximumItemHeight = pageHeight - topInset - bottomInset - 1;
      let currentHeight = 0;

      const outerHeight = (element: HTMLElement) => {
        const computedStyle = window.getComputedStyle(element);
        return (
          element.getBoundingClientRect().height +
          numericMargin(computedStyle.marginTop) +
          numericMargin(computedStyle.marginBottom)
        );
      };

      // Measures a detached candidate by laying it out in the same column, then removing it.
      const measureCandidate = (element: HTMLElement) => {
        contentWrapper.appendChild(element);
        const height = outerHeight(element);
        element.remove();
        return height;
      };

      /**
       * A tall project card that does not fit the remaining space is split between
       * highlight bullets instead of leaving the rest of the page empty. The first
       * part keeps the header, summary, and tech stack; the continuation repeats the
       * title with a "continued" label and carries the remaining bullets and results.
       */
      const splitCard = (card: HTMLElement, availableHeight: number) => {
        if (card.dataset.a4Splittable !== 'true') return null;
        const bullets = card.querySelectorAll('[data-a4-split-list] > li');
        const hasTail = card.querySelector('[data-a4-split-tail]') !== null;
        const minimumLead = 2;
        const minimumRest = hasTail ? 0 : 2;
        const isKorean = document.documentElement.lang.startsWith('ko');

        for (let keep = bullets.length - minimumRest; keep >= minimumLead; keep -= 1) {
          if (keep >= bullets.length && !hasTail) continue;

          const lead = card.cloneNode(true) as HTMLElement;
          lead.querySelectorAll('[data-a4-split-list] > li').forEach((li, index) => {
            if (index >= keep) li.remove();
          });
          lead.querySelector('[data-a4-split-tail]')?.remove();
          lead.dataset.a4SplitPart = 'lead';
          lead.style.marginBottom = '0';
          if (measureCandidate(lead) > availableHeight) continue;

          const rest = card.cloneNode(true) as HTMLElement;
          rest.querySelectorAll('[data-a4-split-list] > li').forEach((li, index) => {
            if (index < keep) li.remove();
          });
          if (keep >= bullets.length) {
            rest.querySelector('[data-a4-split-list]')?.remove();
            const tail = rest.querySelector<HTMLElement>('[data-a4-split-tail]');
            if (tail) {
              tail.style.marginTop = '0';
              tail.style.paddingTop = '0';
              tail.style.borderTop = 'none';
            }
          }
          rest.querySelector('[data-a4-split-summary]')?.remove();
          rest.querySelector('[data-a4-split-aside]')?.remove();
          rest.dataset.a4SplitPart = 'rest';
          const title = rest.querySelector('[data-a4-split-header] h3');
          if (title) {
            const label = document.createElement('span');
            label.className = 'text-[11px] font-semibold text-gray-500';
            label.textContent = isKorean ? '(계속)' : '(continued)';
            title.appendChild(label);
          }
          return { lead, rest };
        }
        return null;
      };

      const queue = children.map((element) => ({ element, height: outerHeight(element) }));
      const minimumSplitSpace = usableHeight * 0.25;
      // Small cards move whole; splitting them leaves a near-empty continuation.
      const minimumSplitCardHeight = usableHeight * 0.45;

      for (let childIndex = 0; childIndex < queue.length; childIndex += 1) {
        const child = queue[childIndex].element;
        const fullItemHeight = queue[childIndex].height;
        const isSectionHeading = child.tagName === 'H2';
        const keepWithNextHeight = isSectionHeading
          ? queue[childIndex + 1]?.height ?? 0
          : 0;
        const explicitlyBreaksBefore = child.dataset.a4BreakBefore === 'true';
        const remainingHeight = usableHeight - currentHeight;

        if (
          currentPageItems.length > 0 &&
          !explicitlyBreaksBefore &&
          fullItemHeight > remainingHeight &&
          fullItemHeight >= minimumSplitCardHeight &&
          remainingHeight >= minimumSplitSpace
        ) {
          const parts = splitCard(child, remainingHeight);
          if (parts) {
            currentPageItems.push(parts.lead);
            pages.push(currentPageItems);
            currentPageItems = [];
            currentHeight = 0;
            queue.splice(childIndex + 1, 0, { element: parts.rest, height: measureCandidate(parts.rest) });
            continue;
          }
        }

        child.removeAttribute('data-a4-oversize');
        if (fullItemHeight > maximumItemHeight) {
          child.dataset.a4Oversize = 'true';
          oversizeItems.push(
            `${container.dataset.template || 'default'} item ${childIndex + 1}: ${Math.round(fullItemHeight)}px > ${Math.round(maximumItemHeight)}px`,
          );
        }

        // Section headings stay with the first item that follows them. This avoids
        // both a heading stranded at the bottom of a page and a forced page break
        // that leaves otherwise usable space behind.
        const wouldOrphanHeading =
          isSectionHeading &&
          currentPageItems.length > 0 &&
          currentHeight + fullItemHeight + keepWithNextHeight > usableHeight;
        const shouldBreak =
          (explicitlyBreaksBefore && currentPageItems.length > 0) ||
          wouldOrphanHeading ||
          (currentHeight + fullItemHeight > usableHeight && currentPageItems.length > 0);

        if (shouldBreak) {
          pages.push(currentPageItems);
          currentPageItems = [child];
          currentHeight = fullItemHeight;
        } else {
          currentPageItems.push(child);
          currentHeight += fullItemHeight;
        }
      }

      if (currentPageItems.length > 0) pages.push(currentPageItems);

      if (pages.length > 0) {
        const fragment = document.createDocumentFragment();
        const originalClasses = container.className.replace('auto-paginate', '').trim();
        const originalContentClasses = contentWrapper.className;

        pages.forEach((pageItems, index) => {
          const pageDiv = document.createElement('div');
          pageDiv.className = `${originalClasses} paginated-page a4-page${index > 0 ? ' print:break-before-page print:mt-0' : ''}`;
          pageDiv.dataset.paginated = 'true';
          pageDiv.dataset.a4Page = `generated-${index + 1}`;
          pageDiv.dataset.a4Owner = container.dataset.a4Owner || '';

          const innerDiv = document.createElement('div');
          innerDiv.className = originalContentClasses;
          innerDiv.dataset.a4PageContent = 'true';

          const topSpacer = document.createElement('div');
          topSpacer.className = 'print-spacer h-[12mm] w-full shrink-0';
          innerDiv.appendChild(topSpacer);

          pageItems.forEach((item) => innerDiv.appendChild(item));

          if (!isCreative) {
            const bottomSpacer = document.createElement('div');
            bottomSpacer.className = 'print-spacer h-[12mm] w-full shrink-0 mt-auto';
            innerDiv.appendChild(bottomSpacer);
          }

          pageDiv.appendChild(innerDiv);
          fragment.appendChild(pageDiv);
        });

        container.before(fragment);
        container.remove();
      }
    });

    const overflowingPages = Array.from(document.querySelectorAll<HTMLElement>('.a4-page'))
      .filter(
        (page) =>
          page.scrollHeight > page.clientHeight + 1 || page.scrollWidth > page.clientWidth + 1,
      )
      .map((page) => page.dataset.a4Page || 'unknown');

    document.documentElement.dataset.a4OversizeCount = String(oversizeItems.length);
    document.documentElement.dataset.a4OverflowCount = String(overflowingPages.length);
    document.documentElement.dataset.a4PaginationReady = 'true';
    window.dispatchEvent(
      new CustomEvent('a4-pagination-ready', {
        detail: { oversizeItems, overflowingPages },
      }),
    );
  }

  async function paginateAfterLayout() {
    if (document.fonts?.ready) {
      await document.fonts.ready;
    }
    await twoAnimationFrames();
    renderForCurrentViewport();
  }

  function usesContinuousMobileLayout() {
    return !window.matchMedia('print').matches && window.innerWidth < MOBILE_BREAKPOINT_PX;
  }

  function renderForCurrentViewport() {
    restorePaginationSources();

    if (usesContinuousMobileLayout()) {
      document.documentElement.dataset.a4OversizeCount = '0';
      document.documentElement.dataset.a4OverflowCount = '0';
      document.documentElement.dataset.a4PaginationReady = 'true';
      window.dispatchEvent(
        new CustomEvent('a4-pagination-ready', {
          detail: { oversizeItems: [], overflowingPages: [], continuous: true },
        }),
      );
      return;
    }

    paginateNow();
  }

  function repaginateForCurrentMedia() {
    renderForCurrentViewport();
  }

  window.addEventListener('load', () => {
    document.documentElement.dataset.a4Debug =
      new URLSearchParams(window.location.search).get('a4-debug') === '1' ? 'true' : 'false';
    rememberPaginationSources();
    void paginateAfterLayout();
  });

  window.addEventListener('beforeprint', repaginateForCurrentMedia);
  window.addEventListener('afterprint', () => {
    void paginateAfterLayout();
  });

  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => void paginateAfterLayout(), 150);
  });

  window.matchMedia('print').addEventListener('change', (event) => {
    if (event.matches) {
      repaginateForCurrentMedia();
    }
  });
</script>

<style is:global>
  .paginated-page {
    position: relative;
    background: white;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
    min-height: 297mm;
    display: flex;
    flex-direction: column;
  }

  html[data-a4-debug='true'] .a4-page::before,
  html[data-a4-debug='true'] .a4-page::after {
    content: '';
    position: absolute;
    pointer-events: none;
    z-index: 9999;
  }

  html[data-a4-debug='true'] .a4-page::before {
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(14 165 233 / 0.16) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(14 165 233 / 0.16) 1px, transparent 1px),
      linear-gradient(to right, rgb(239 68 68 / 0.22) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(239 68 68 / 0.22) 1px, transparent 1px);
    background-size: 5mm 5mm, 5mm 5mm, 10mm 10mm, 10mm 10mm;
  }

  html[data-a4-debug='true'] .a4-page::after {
    inset: 12mm;
    border: 0.35mm dashed rgb(220 38 38 / 0.85);
  }

  html[data-a4-debug='true'] [data-a4-oversize='true'] {
    outline: 1mm solid rgb(220 38 38 / 0.9) !important;
    outline-offset: 1mm;
  }

  @media screen and (max-width: 767px) {
    .a4-page,
    .auto-paginate {
      width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      overflow: visible !important;
      box-shadow: none !important;
    }

    .paginate-content {
      padding-top: 1.5rem !important;
      padding-bottom: 1.5rem !important;
    }
  }

  @media print {
    .print\:break-before-page {
      break-before: page !important;
    }

    .a4-page {
      width: 210mm !important;
      height: 297mm !important;
      min-height: 297mm !important;
      max-height: 297mm !important;
      box-shadow: none !important;
      margin: 0 !important;
      overflow: hidden !important;
    }

    html[lang='ko'] .a4-page {
      word-break: keep-all;
      overflow-wrap: break-word;
    }
  }
</style>
